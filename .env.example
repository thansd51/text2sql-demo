# 복사해서 .env로 사용한다. 실제 값은 저장소에 올리지 않는다.
# 아래는 로컬 개발용 기본값이다. 배포용 값은 맨 아래에 있다.
TEXT2SQL_APP_NAME=text2sql
# LLM 종류: openai(OpenAI 호환 API: OpenAI, Ollama, llama.cpp) 또는 anthropic(Claude 공식 API)
TEXT2SQL_LLM_PROVIDER=openai
# openai일 때만 쓴다 (anthropic이면 무시). 기본값은 ./scripts/llm-start.sh로 띄우는 로컬 모델 주소다.
TEXT2SQL_LLM_BASE_URL=http://localhost:8083/v1
TEXT2SQL_LLM_MODEL=default
TEXT2SQL_LLM_TIMEOUT_SECONDS=120
TEXT2SQL_LLM_MAX_TOKENS=512
# 모델이 한 번에 받을 수 있는 토큰(프롬프트+답변). 프롬프트가 넘치면 질문과 관련 있는 테이블만 넣는다.
# Ollama는 num_ctx와 같은 값으로 맞춘다. 너무 작으면 서버가 시작할 때 실패한다.
TEXT2SQL_LLM_CONTEXT_TOKENS=16384
# 글자 수로 토큰을 어림하는 값(1토큰당 글자 수). 모델이 한글을 잘게 쪼개면 낮춘다.
# TEXT2SQL_LLM_CHARS_PER_TOKEN=1.8
# 답변 길이 제한 필드: auto(기본, OpenAI면 max_completion_tokens, 그 밖에는 max_tokens)
# TEXT2SQL_LLM_MAX_TOKENS_FIELD=auto
# 일부 모델(OpenAI 추론 계열 등)은 temperature를 거부한다. 그런 모델이면 false.
# TEXT2SQL_LLM_SEND_TEMPERATURE=true
# anthropic 전용: 생각에 쓰는 깊이(low, medium, high, xhigh, max). 낮을수록 빠르고 싸다.
# TEXT2SQL_LLM_EFFORT=low
# anthropic 전용: 모델이 요청을 거절하면 다른 모델이 이어받게 한다. 지원하지 않는 모델이면 false.
# TEXT2SQL_LLM_ANTHROPIC_FALLBACKS=true
# LLM 키가 필요하면 .env(또는 배포 환경의 Variables)에만 적는다 (비밀 값)
# TEXT2SQL_LLM_API_KEY=
# 1차 검증 실패 시 오류를 넣어 다시 시도하는 최대 횟수
TEXT2SQL_MAX_REPAIR_ATTEMPTS=2
# 질문 최대 글자 수
TEXT2SQL_MAX_QUESTION_LENGTH=500
# 결과 행 수 상한 (최종 SQL에 강제로 걸린다)
TEXT2SQL_MAX_ROWS=1000
# 경로를 지정하지 않으면 프로젝트 루트 아래 datasources, semantic, profiles를 쓴다.
# TEXT2SQL_DATASOURCES_DIR=
# TEXT2SQL_SEMANTIC_DIR=
# TEXT2SQL_PROFILES_DIR=
# TEXT2SQL_EXAMPLES_DIR=

# 접속 키 검사. 로컬 개발에서만 끈다. 배포 환경에는 이 줄을 넣지 않는다.
TEXT2SQL_AUTH_DISABLED=true

# ======================================================================
# 배포용 (OpenAI). 배포 서비스의 환경변수(Variables)에 아래 5개를 넣으면 된다.
# 이 파일이나 저장소에는 실제 값을 적지 않는다. TEXT2SQL_AUTH_DISABLED는 넣지 않는다.
#
#   TEXT2SQL_LLM_BASE_URL=https://api.openai.com/v1
#   TEXT2SQL_LLM_MODEL=gpt-4o-mini          # 계정에서 쓸 수 있는 모델 이름 (예시)
#   TEXT2SQL_LLM_API_KEY=sk-...             # OpenAI API 키 (비밀)
#   TEXT2SQL_LLM_CONTEXT_TOKENS=128000      # 모델의 컨텍스트 크기에 맞춘다
#   TEXT2SQL_ACCESS_KEY=충분히-긴-임의-문자열  # 화면에서 입력하는 접속 키 (비밀)
#
# Claude(Anthropic)를 쓰려면 위 5개 대신 아래를 넣는다 (TEXT2SQL_LLM_BASE_URL은 필요 없다):
#
#   TEXT2SQL_LLM_PROVIDER=anthropic
#   TEXT2SQL_LLM_MODEL=claude-opus-5-5
#   TEXT2SQL_LLM_API_KEY=sk-ant-...         # Anthropic API 키 (비밀)
#   TEXT2SQL_LLM_CONTEXT_TOKENS=200000
#   TEXT2SQL_LLM_MAX_TOKENS=4096            # 생각에 쓰는 토큰도 포함되므로 512는 너무 작다
#   TEXT2SQL_ACCESS_KEY=충분히-긴-임의-문자열
#
# OpenAI에서 추론 계열 모델(o 시리즈, gpt-5 등)을 쓰면 추가로:
#   TEXT2SQL_LLM_SEND_TEMPERATURE=false
#   TEXT2SQL_LLM_MAX_TOKENS=4096            # 추론에 쓰는 토큰까지 포함되므로 넉넉하게
# ======================================================================
